RewriteEngine On
DirectoryIndex index.html

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.html [L]

<IfModule mod_mime.c>
AddType application/javascript .js
AddType application/wasm .wasm
AddType application/octet-stream .data
</IfModule>

# Unity's compressed player files are named "<hash>.wasm.br" etc. Apache must report
# the type of the file INSIDE the container (.wasm) plus the encoding (br).
#
# Do NOT use "AddEncoding br .br" here as well: mod_mime stores the encoding outside
# the response header table, so the "Header set" below does not replace it - Apache
# then sends "Content-Encoding: br" twice, the browser tries to brotli-decode the
# stream twice, and the loader reports "Unable to load file Build/<hash>.wasm.br".
<FilesMatch "\.js\.(br|gz)$">
ForceType application/javascript
</FilesMatch>

<FilesMatch "\.wasm\.(br|gz)$">
ForceType application/wasm
</FilesMatch>

<FilesMatch "\.data\.(br|gz)$">
ForceType application/octet-stream
</FilesMatch>

<IfModule mod_headers.c>
<FilesMatch "\.(js|wasm|data|symbols\.json)\.br$">
Header set Content-Encoding br
</FilesMatch>

<FilesMatch "\.(js|wasm|data|symbols\.json)\.gz$">
Header set Content-Encoding gzip
</FilesMatch>
</IfModule>

<IfModule mod_headers.c>
# index.html must always be revalidated so a new build is picked up immediately.
<FilesMatch "^index\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>

# Build output is named as hashes (Publishing Settings > Name Files As Hashes),
# so every file name is content-addressed and can be cached forever.
# Scoped to Build/ so unhashed StreamingAssets files are not frozen too.
SetEnvIf Request_URI "/Build/" ZERO_IMMUTABLE=1
Header set Cache-Control "public, max-age=31536000, immutable" env=ZERO_IMMUTABLE
</IfModule>
