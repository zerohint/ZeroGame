RewriteEngine On
DirectoryIndex index.html

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.html [L]

<IfModule mod_mime.c>
AddEncoding br .br
AddEncoding gzip .gz

AddType application/javascript .js
AddType application/javascript .js.br
AddType application/javascript .js.gz

AddType application/wasm .wasm
AddType application/wasm .wasm.br
AddType application/wasm .wasm.gz

AddType application/octet-stream .data
AddType application/octet-stream .data.br
AddType application/octet-stream .data.gz
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(js|wasm|data)\.br$">
Header set Content-Encoding br
</FilesMatch>

<FilesMatch "\.(js|wasm|data)\.gz$">
Header set Content-Encoding gzip
</FilesMatch>
</IfModule>

<IfModule mod_headers.c>
# index.html must always be revalidated so a new build is picked up immediately.
<FilesMatch "^index\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>

# Build output is named as hashes (Publishing Settings > Name Files As Hashes),
# so every file name is content-addressed and can be cached forever.
# Scoped to Build/ so unhashed StreamingAssets files are not frozen too.
SetEnvIf Request_URI "/Build/" ZERO_IMMUTABLE=1
Header set Cache-Control "public, max-age=31536000, immutable" env=ZERO_IMMUTABLE
</IfModule>
